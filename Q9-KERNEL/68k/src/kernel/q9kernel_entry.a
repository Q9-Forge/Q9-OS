Q9K_IOpenScratch_NamePtr  equ $1364      * Q9_u32, (a0) EIN
Q9K_IOpenScratch_PastName equ $1368      * Q9_u32, (a0) AUS
Q9K_IOpenScratch_PathNum  equ $136C      * Q9_u32, d0.w AUS (0 = Fehlschlag)

