Q9K_TLinkTrace_InitEntry equ $154120
Q9K_TLinkTrace_ExecEntry equ $154124
Q9K_TLinkTrace_StaticPtr equ $154128
Q9K_TLinkTrace_Error     equ $15412C
Q9K_TLinkTrace_Success   equ $154130
Q9K_FLinkTrace_Status    equ $154140
Q9K_FLinkTrace_D0        equ $154144
Q9K_FLinkTrace_D1        equ $154148
