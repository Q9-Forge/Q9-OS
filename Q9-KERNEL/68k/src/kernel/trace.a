*******************************************************************************
* trace -- Syscall-Trace des Q9-Developer-Kernels steuern und anzeigen
* (docs/DEBUG_KONZEPT_de.md, Abschnitt 2.7; Fortsetzung 121).
*
*   trace on      Trace einschalten (F$Q9Dbg Unterfunktion 1, d1=1) mit
*                 Detailstufe 2 (Unterfunktion 5): Register und Namen je Satz
*   trace off     Trace ausschalten
*   trace clear   Ringpuffer leeren (Unterfunktion 7)
*   trace show    Trace ausschalten und den Puffer anzeigen
*   trace mask    Syscall-Maske mit +Name/-Name aendern
*   trace filter  pid=, user=, path= oder error= setzen
*   trace         Trace AUSSCHALTEN und den Puffer dekodiert ausgeben
*                 (Unterfunktion 6, liest und verbraucht ganze Saetze)
*
* Beim Anzeigen wird der Trace bewusst ausgeschaltet: das Auslesen schreibt
* selbst ueber I$WritLn und wuerde sonst ohne Ende nachprotokolliert.
*
* Ausgabezeile: <Tick hex> <PID hex> <Einrueckung je Tiefe> -> / <- Name
* [CARRY] [ d0=.. d1=.. d2=.. a0=.. a1=.. ["Name"]]. Register: beim Eintritt
* die Eingaben, bei der Rueckkehr die Ausgaben. "!!" markiert einen Verlust-Satz (ueberschriebene Saetze).
* Satzformat s. q9trace.h (12-Byte-Kopf: Typ, Laenge, Callcode, Flags,
* PID.w, Tick.l, Feinzeit.w).
*
* Bewusst reiner Assembler ohne csl: das Werkzeug soll auch dann laufen,
* wenn die C-Laufzeit gerade das Problem ist. Im Atom-Kernel liefert
* F$Q9Dbg E$UnkSvc -- trace meldet dann einen Fehler.
*******************************************************************************
Q9Prgrm                 equ     1
Q9Objct                 equ     1
TrEdition               equ     1
TrStackSize             equ     $800
TrReadMax               equ     480             * max. Byte je Lesevorgang (ganze Saetze)

        psect   trace,(Q9Prgrm<<8)!Q9Objct,(0<<8)!1,TrEdition,TrStackSize,TrStart

        vsect
TrBuf:  ds.b    512
TrLine: ds.b    160
TrMaskBytes: ds.b 32
        ends

TrStart:
        movea.l a5,a0                           * a5 = Parameterzeichenkette (OS-9-Startkonvention)
TrSkip:
        cmpi.b  #' ',(a0)
        bne.s   TrArg
        addq.l  #1,a0
        bra.s   TrSkip
TrArg:
        move.b  (a0),d0
        cmpi.b  #'f',d0
        bne.s   TrNotF
        cmpi.b  #'f',1(a0)
        beq     TrOff
        cmpi.b  #'i',1(a0)
        beq     TrFilterCmd
        bra     TrUsage
TrNotF:
        cmpi.b  #'o',d0
        bne.s   TrNotO
        cmpi.b  #'n',1(a0)
        beq.s   TrOn
        cmpi.b  #'f',1(a0)
        beq     TrOff
        bra     TrUsage
TrNotO:
        cmpi.b  #'s',d0
        bne.s   TrNotS
        cmpi.b  #'h',1(a0)
        bne     TrUsage
        cmpi.b  #'o',2(a0)
        bne     TrUsage
        cmpi.b  #'w',3(a0)
        bne     TrUsage
        bra     TrDump
TrNotS:
        cmpi.b  #'m',d0
        bne.s   TrNotM
        cmpi.b  #'a',1(a0)
        bne     TrUsage
        cmpi.b  #'s',2(a0)
        bne     TrUsage
        cmpi.b  #'k',3(a0)
        bne     TrUsage
        bra     TrMaskCmd
TrNotM:
        cmpi.b  #'c',d0
        beq.s   TrClear
        cmpi.b  #$0d,d0
        beq     TrDump
        tst.b   d0
        beq     TrDump
        bra     TrUsage

TrOn:
        moveq   #5,d0
        moveq   #2,d1                           * Detailstufe 2: Register und Namen mitschreiben
        moveq   #0,d2                           * Ausgabe: nur Ringpuffer
        trap    #0
        dc.w    $7f                             * F$Q9Dbg: Detailstufe/Modus setzen
        bcs     TrErr
        moveq   #1,d0
        moveq   #1,d1
        trap    #0
        dc.w    $7f                             * F$Q9Dbg: Trace an
        bcs     TrErr
        lea     TrMsgOn(pc),a0
        bra     TrSay
TrOff:
        moveq   #1,d0
        moveq   #0,d1
        trap    #0
        dc.w    $7f                             * F$Q9Dbg: Trace aus
        bcs     TrErr
        lea     TrMsgOff(pc),a0
        bra     TrSay
TrClear:
        moveq   #7,d0
        moveq   #0,d3
        trap    #0
        dc.w    $7f                             * F$Q9Dbg: Puffer 0 leeren
        bcs     TrErr
        lea     TrMsgClr(pc),a0
        bra     TrSay

*******************************************************************************
* TrMaskCmd -- Syscall-Maske per +Name/-Name aendern.
* Beispiel: trace mask +I$Open -F$ID
* Erst die aktuelle Maske lesen, Aenderungen lokal sammeln und zum Schluss
* genau einmal zurueckschreiben. Bei einem Tippfehler bleibt sie unveraendert.
TrMaskCmd:
        cmpi.b  #' ',4(a0)
        beq.s   TrMaskBegin
        cmpi.b  #$0d,4(a0)
        beq.s   TrMaskBegin
        tst.b   4(a0)
        bne     TrUsage
TrMaskBegin:
        lea     4(a0),a0
        move.l  a0,-(sp)                         * Parameterzeiger sichern
        lea     TrMaskBytes(a6),a0
        moveq   #3,d0                           * aktuelle 32-Byte-Maske holen
        trap    #0
        dc.w    $7f
        bcs     TrErr
        movea.l (sp)+,a0
        moveq   #0,d7                           * mindestens eine Aenderung?
TrMaskNext:
TrMaskSkip:
        cmpi.b  #' ',(a0)
        bne.s   TrMaskAtEnd
        addq.l  #1,a0
        bra.s   TrMaskSkip
TrMaskAtEnd:
        cmpi.b  #$0d,(a0)
        beq.s   TrMaskCommit
        tst.b   (a0)
        beq.s   TrMaskCommit
        move.b  (a0)+,d6                        * '+' setzen, '-' loeschen
        cmpi.b  #'+',d6
        beq.s   TrMaskToken
        cmpi.b  #'-',d6
        bne     TrUsage
TrMaskToken:
        bsr     TrFindCallcode
        cmpi.w  #$ffff,d1
        beq     TrUsage
        move.w  d1,d2
        move.w  d2,d3
        andi.w  #7,d3
        lsr.w   #3,d2                            * Byteindex = Code / 8
        moveq   #1,d4
        lsl.b   d3,d4                            * Bit = 1 << (Code & 7)
        lea     TrMaskBytes(a6),a1
        cmpi.b  #'+',d6
        bne.s   TrMaskOff
        or.b    d4,0(a1,d2.w)
        bra.s   TrMaskChanged
TrMaskOff:
        not.b   d4
        and.b   d4,0(a1,d2.w)
TrMaskChanged:
        addq.w  #1,d7
        bra     TrMaskNext
TrMaskCommit:
        tst.w   d7
        beq     TrUsage
        lea     TrMaskBytes(a6),a0
        moveq   #2,d0                           * atomar zurueckschreiben
        trap    #0
        dc.w    $7f
        bcs     TrErr
        lea     TrMsgMask(pc),a0
        bra     TrSay

*******************************************************************************
* TrFilterCmd -- einen Filterwert setzen.
* Syntax (ein Wert je Aufruf): trace filter pid=7 | user=0.5 | path=3 | error=on|off | detail=1..3
* Pfadnamen -> Datei-ID bleibt offen, weil der RBF-FD-Sektor erst aus
* dem echten I$GetStt-Vertrag beschafft werden muss.
TrFilterCmd:
        cmpi.b  #'i',1(a0)
        bne     TrUsage
        cmpi.b  #'l',2(a0)
        bne     TrUsage
        cmpi.b  #'t',3(a0)
        bne     TrUsage
        cmpi.b  #'e',4(a0)
        bne     TrUsage
        cmpi.b  #'r',5(a0)
        bne     TrUsage
        cmpi.b  #' ',6(a0)
        bne     TrUsage
        lea     7(a0),a0
        cmpi.b  #'p',(a0)
        bne.s   TrFiltNotP
        cmpi.b  #'i',1(a0)
        beq.s   TrFiltPID
        cmpi.b  #'a',1(a0)
        beq     TrFiltPath
        bra     TrUsage
TrFiltPID:
        cmpi.b  #'d',2(a0)
        bne     TrUsage
        cmpi.b  #'=',3(a0)
        bne     TrUsage
        lea     4(a0),a0
        moveq   #1,d6                           * PID
        bsr     TrParseDecimal
        bra     TrFiltValidate
TrFiltNotP:
        cmpi.b  #'u',(a0)
        bne.s   TrFiltNotU
        cmpi.b  #'s',1(a0)
        bne     TrUsage
        cmpi.b  #'e',2(a0)
        bne     TrUsage
        cmpi.b  #'r',3(a0)
        bne     TrUsage
        cmpi.b  #'=',4(a0)
        bne     TrUsage
        lea     5(a0),a0
        moveq   #2,d6                           * Gruppe.Benutzer
        bsr     TrParseDecimal
        move.l  d1,d2                           * Gruppe
        cmpi.l  #255,d2
        bhi     TrUsage
        cmpi.b  #'.',(a0)
        bne     TrUsage
        addq.l  #1,a0
        bsr     TrParseDecimal
        cmpi.l  #255,d1
        bhi     TrUsage
        lsl.w   #8,d2
        or.w    d1,d2                           * gepackte Gruppe.Benutzer
        move.l  d2,d1
        bra     TrFiltValidate
TrFiltNotU:
        cmpi.b  #'d',(a0)
        bne.s   TrFiltNotD
        cmpi.b  #'e',1(a0)
        bne     TrUsage
        cmpi.b  #'t',2(a0)
        bne     TrUsage
        cmpi.b  #'a',3(a0)
        bne     TrUsage
        cmpi.b  #'i',4(a0)
        bne     TrUsage
        cmpi.b  #'l',5(a0)
        bne     TrUsage
        cmpi.b  #'=',6(a0)
        bne     TrUsage
        lea     7(a0),a0
        moveq   #6,d6                           * Detailstufe 1..3
        bsr     TrParseDecimal
        tst.l   d1
        beq     TrUsage
        cmpi.l  #3,d1
        bhi     TrUsage
        bra     TrFiltValidate
TrFiltNotD:
        cmpi.b  #'e',(a0)
        bne     TrUsage
        cmpi.b  #'r',1(a0)
        bne     TrUsage
        cmpi.b  #'r',2(a0)
        bne     TrUsage
        cmpi.b  #'o',3(a0)
        bne     TrUsage
        cmpi.b  #'r',4(a0)
        bne     TrUsage
        cmpi.b  #'=',5(a0)
        bne     TrUsage
        lea     6(a0),a0
        moveq   #5,d6                           * nur Fehler
        cmpi.b  #'o',(a0)
        bne.s   TrFiltErrOff
        cmpi.b  #'n',1(a0)
        bne     TrUsage
        addq.l  #2,a0
        moveq   #1,d1
        bra     TrFiltValidate
TrFiltErrOff:
        cmpi.b  #'o',(a0)
        bne     TrUsage
        cmpi.b  #'f',1(a0)
        bne     TrUsage
        cmpi.b  #'f',2(a0)
        bne     TrUsage
        addq.l  #3,a0
        moveq   #0,d1
        bra     TrFiltValidate
TrFiltPath:
        cmpi.b  #'t',2(a0)
        bne     TrUsage
        cmpi.b  #'h',3(a0)
        bne     TrUsage
        cmpi.b  #'=',4(a0)
        bne     TrUsage
        lea     5(a0),a0
        moveq   #3,d6                           * Pfadnummer; 65535 = keiner
        bsr     TrParseDecimal
TrFiltValidate:
        cmpi.b  #' ',(a0)
        bne.s   TrFiltValidateEnd
        addq.l  #1,a0
        bra     TrFiltValidate
TrFiltValidateEnd:
        cmpi.b  #$0d,(a0)
        beq.s   TrFiltApply
        tst.b   (a0)
        bne     TrUsage
TrFiltApply:
        move.l  d1,d2                           * Wert
        move.l  d6,d1                           * Filterart
        moveq   #4,d0                           * F$Q9Dbg: Filter setzen
        trap    #0
        dc.w    $7f
        bcs     TrErr
        lea     TrMsgFilter(pc),a0
        bra     TrSay

* Liest eine Dezimalzahl aus a0, begrenzt auf 0..65535.
* Rueckgabe d1=Zahl, a0=erstes Zeichen danach. Fehler -> TrUsage.
TrParseDecimal:
        movem.l d2-d3,-(sp)
        moveq   #0,d1
        moveq   #0,d3
TrPDLoop:
        moveq   #0,d0
        move.b  (a0),d0
        cmpi.b  #'0',d0
        bcs.s   TrPDEnd
        cmpi.b  #'9',d0
        bhi.s   TrPDEnd
        subi.b  #'0',d0
        mulu.w  #10,d1
        andi.l  #$ff,d0
        add.l   d0,d1
        cmpi.l  #65535,d1
        bhi     TrPDError
        addq.l  #1,a0
        addq.w  #1,d3
        bra.s   TrPDLoop
TrPDEnd:
        tst.w   d3
        beq     TrPDError
        movem.l (sp)+,d2-d3
        rts
TrPDError:
        movem.l (sp)+,d2-d3
        bra     TrUsage

*******************************************************************************
* TrFindCallcode -- a0 zeigt auf einen Syscall-Namen. Rueckgabe d1=Code,
* a0 zeigt auf Tokenende. TrMaskNames enthaelt alle bekannten Syscalls.
TrFindCallcode:
        movem.l d2-d5/a2-a5,-(sp)
        movea.l a0,a4
        movea.l a0,a2
        moveq   #0,d5
TrFCLen:
        move.b  (a2),d0
        cmpi.b  #' ',d0
        beq.s   TrFCLenDone
        cmpi.b  #$0d,d0
        beq.s   TrFCLenDone
        tst.b   d0
        beq.s   TrFCLenDone
        addq.w  #1,d5
        addq.l  #1,a2
        cmpi.w  #10,d5
        bhi.s   TrFCFail
        bra.s   TrFCLen
TrFCLenDone:
        tst.w   d5
        beq.s   TrFCFail
        movea.l a2,a0                           * Rueckgabeposition
        lea     TrMaskNames(pc),a3
TrFCEntry:
        cmpi.b  #$ff,(a3)
        beq.s   TrFCFail
        movea.l a4,a2
        lea     1(a3),a5
        move.w  d5,d3
TrFCChar:
        tst.w   d3
        beq.s   TrFCExact
        move.b  (a2)+,d0
        cmp.b   (a5)+,d0
        bne.s   TrFCNext
        subq.w  #1,d3
        bra.s   TrFCChar
TrFCExact:
        cmpi.w  #10,d5
        beq.s   TrFCFound
        cmpi.b  #' ',(a5)
        bne.s   TrFCNext
TrFCFound:
        moveq   #0,d1
        move.b  (a3),d1
        movem.l (sp)+,d2-d5/a2-a5
        rts
TrFCNext:
        lea     9(a3),a3
        bra     TrFCEntry
TrFCFail:
        moveq   #0,d1
        move.w  #$ffff,d1
        movem.l (sp)+,d2-d5/a2-a5
        rts

TrDump:
        moveq   #1,d0
        moveq   #0,d1
        trap    #0
        dc.w    $7f                             * zuerst Trace aus (s. Kopfkommentar)
        bcs     TrErr
TrRead:
        lea     TrBuf(a6),a0
        moveq   #6,d0
        moveq   #0,d1
        move.l  #TrReadMax,d2
        moveq   #0,d3
        trap    #0
        dc.w    $7f                             * F$Q9Dbg: Ringpuffer lesen -> d0 = Byte
        bcs     TrErr
        tst.l   d0
        beq     TrDone
        lea     TrBuf(a6),a2
        move.l  d0,d4                           * d4 = noch zu dekodierende Byte
TrRec:
        tst.l   d4
        ble.s   TrRead
        moveq   #0,d5
        move.b  1(a2),d5                        * Satzlaenge
        cmpi.b  #12,d5
        bcs.s   TrRead                          * kaputt -- naechsten Block holen
        bsr     TrFmt
        adda.l  d5,a2
        sub.l   d5,d4
        bra.s   TrRec
TrDone:
        lea     TrMsgEnd(pc),a0

TrSay:
        moveq   #1,d0
        moveq   #80,d1
        trap    #0
        dc.w    $008c                           * I$WritLn
        moveq   #0,d1
        trap    #0
        dc.w    6                               * F$Exit 0
TrUsage:
        lea     TrMsgUse(pc),a0
        bra.s   TrSay
TrErr:
        trap    #0
        dc.w    6                               * F$Exit mit Fehlercode in d1

*******************************************************************************
* TrFmt -- eine Zeile fuer den Satz bei (a2) bauen und ausgeben.
* Erhaelt a2/d4/d5.
TrFmt:
        movem.l d4-d5/a2,-(sp)
        lea     TrLine(a6),a1
        move.l  6(a2),d1                        * Tick
        moveq   #8,d2
        bsr     TrHex
        move.b  #' ',(a1)+
        moveq   #0,d1
        move.w  4(a2),d1                        * PID
        moveq   #4,d2
        bsr     TrHex
        move.b  #' ',(a1)+
        cmpi.b  #5,(a2)                         * Verlust-Satz?
        bne.s   TrFmtNorm
        lea     TrMsgLost(pc),a3
TrFmtLostC:
        move.b  (a3)+,d0
        beq.s   TrFmtLostN
        move.b  d0,(a1)+
        bra.s   TrFmtLostC
TrFmtLostN:
        move.l  12(a2),d1                       * Anzahl verlorener Saetze
        moveq   #8,d2
        bsr     TrHex
        bra     TrFmtEnd
TrFmtNorm:
        moveq   #0,d1
        move.b  3(a2),d1
        andi.b  #$0f,d1                         * Tiefe
TrInd:
        subq.w  #1,d1
        bmi.s   TrIndE
        move.b  #' ',(a1)+
        move.b  #' ',(a1)+
        bra.s   TrInd
TrIndE:
        move.b  #'?',d0
        move.b  #'?',d1
        cmpi.b  #1,(a2)
        bne.s   TrNotEnt
        move.b  #'-',d0
        move.b  #'>',d1
TrNotEnt:
        cmpi.b  #2,(a2)
        bne.s   TrNotRet
        move.b  #'<',d0
        move.b  #'-',d1
TrNotRet:
        move.b  d0,(a1)+
        move.b  d1,(a1)+
        move.b  #' ',(a1)+
        lea     TrNames(pc),a3
TrNmL:
        move.b  (a3),d1
        cmpi.b  #$ff,d1
        beq.s   TrNmNo
        cmp.b   2(a2),d1
        beq.s   TrNmHit
        lea     9(a3),a3
        bra.s   TrNmL
TrNmHit:
        addq.l  #1,a3
        moveq   #7,d1
TrNmC:
        move.b  (a3)+,d0
        cmpi.b  #' ',d0
        beq.s   TrNmE
        move.b  d0,(a1)+
        dbra    d1,TrNmC
        bra.s   TrNmE
TrNmNo:
        move.b  #'$',(a1)+
        moveq   #0,d1
        move.b  2(a2),d1
        moveq   #2,d2
        bsr     TrHex
TrNmE:
        btst    #4,3(a2)                        * Carry = Fehler
        beq.s   TrPay
        lea     TrMsgCarry(pc),a3
TrCaC:
        move.b  (a3)+,d0
        beq.s   TrPay
        move.b  d0,(a1)+
        bra.s   TrCaC
* Nutzdaten (Detailstufe 2): d0,d1,d2,a0,a1 je 4 Byte ab Offset 12, danach
* optional Namenslaenge + Name (q9kernel_dbg.c, Q9DBG_PAY_REGS).
TrPay:
        cmpi.w  #32,d5
        bcs.s   TrFmtEnd                        * Satz ohne Nutzdaten
        lea     12(a2),a4
        lea     TrRegLbl(pc),a3
        moveq   #4,d3
TrPayL:
        moveq   #3,d0
TrPayC:
        move.b  (a3)+,(a1)+
        dbra    d0,TrPayC
        move.l  (a4)+,d1
        moveq   #8,d2
        bsr     TrHex
        dbra    d3,TrPayL
        cmpi.w  #33,d5
        bcs.s   TrFmtEnd                        * kein Name
        move.b  #' ',(a1)+
        move.b  #'"',(a1)+
        moveq   #0,d0
        move.b  32(a2),d0                       * Namenslaenge
        lea     33(a2),a4
        subq.w  #1,d0
        bmi.s   TrNameQ
TrNameC:
        move.b  (a4)+,(a1)+
        dbra    d0,TrNameC
TrNameQ:
        move.b  #'"',(a1)+
TrFmtEnd:
        move.b  #$0d,(a1)+
        lea     TrLine(a6),a0
        moveq   #1,d0
        move.l  #160,d1
        trap    #0
        dc.w    $008c                           * I$WritLn
        movem.l (sp)+,d4-d5/a2
        rts

*******************************************************************************
* TrHex -- d1 als d2 Hexziffern nach (a1)+ (hoechste zuerst).
TrHex:
        movem.l d0-d1/d3,-(sp)
        adda.w  d2,a1
        move.l  a1,-(sp)
        move.w  d2,d3
        subq.w  #1,d3
TrHexL:
        move.b  d1,d0
        andi.b  #$0f,d0
        cmpi.b  #10,d0
        bcs.s   TrHexD
        addq.b  #7,d0
TrHexD:
        addi.b  #'0',d0
        move.b  d0,-(a1)
        lsr.l   #4,d1
        dbra    d3,TrHexL
        movea.l (sp)+,a1
        movem.l (sp)+,d0-d1/d3
        rts

*******************************************************************************
* Namen: je Eintrag Callcode-Byte + 8 Zeichen (mit Leerzeichen aufgefuellt).
TrNames:
        dc.b    $00,"F$Link  ",$01,"F$Load  ",$02,"F$UnLink",$03,"F$Fork  "
        dc.b    $04,"F$Wait  ",$05,"F$Chain ",$06,"F$Exit  ",$07,"F$Mem   "
        dc.b    $08,"F$Send  ",$09,"F$Icpt  ",$0a,"F$Sleep ",$0c,"F$ID    "
        dc.b    $0e,"F$STrap ",$0f,"F$PErr  ",$10,"F$PrsNam",$11,"F$CmpNam"
        dc.b    $15,"F$Time  ",$16,"F$STime ",$18,"F$GPrDsc",$1a,"F$GModDr"
        dc.b    $1b,"F$CpyMem",$1c,"F$SUser ",$1e,"F$RTE   ",$20,"F$Julian"
        dc.b    $21,"F$TLink ",$27,"F$SetSys",$28,"F$SRqMem",$29,"F$SRtMem"
        dc.b    $2a,"F$IRQ   ",$2b,"F$IOQu  ",$2e,"F$VModul",$32,"F$SSvc  "
