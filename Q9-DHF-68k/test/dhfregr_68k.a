PD0             dc.b    "/d0",0
PDup            dc.b    "/d0/rt/dup.txt",0
PSib            dc.b    "/d0/../d0_nachbar/geheim.txt",0
PEsc            dc.b    "/d0/../../../../../../../../etc/hosts",0

Data10          dc.b    "ABCDEFGHIJ"
DataLn          dc.b    "Zeile1",$0D,"XYZ"
DataDup         dc.b    "DUP!"

N01     dc.b    "01 MakDir /d0/rt",0
