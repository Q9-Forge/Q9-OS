*═══════════════════════════════════════════════════════════════════════════
* File:   dhfsetstt_68k.a                                             Ver. 1.00
* Owner:  Claude
* Desc.:  Minimales OS-9-Programmmodul, das I$Open/I$SetStt(SS_Size)/I$Close
*         gegen eine feste Datei unter DHF aufruft -- Test fuer die neu
*         verdrahtete Mgr_SetStt-Routine (manager/dhfmgr_68k.a), Aufbau nach
*         dem Vorbild von dhftest_68k.a.
*
* Edition History
*─────────┬──────┬────────────────────────────────────────────────────────┬──────
* Date    │ Ver. │ Description                                            │ By
*─────────┼──────┼────────────────────────────────────────────────────────┼──────
* 26-09-26│ 1.00 │ Erster Wurf                                            │ Cld
*═════════╧══════╧════════════════════════════════════════════════════════╧══════
        nam     dhfsst
        ttl     Q9-DHF Testprogramm: I$Open/I$SetStt(SS_Size)/I$Close

        use     q9defs.d

Edition         equ     1

I_OPEN          equ     $84
I_CLOSE         equ     $8f
I_SETSTT        equ     $8e

SS_Size         equ     $02
NEW_SIZE        equ     5               * Datei auf 5 Byte kuerzen ("Hallo" ohne Rest)

STDOUT          equ     1

        psect   dhfsst,(Prgrm<<8)!Objct,0,Edition,1024,Start

Start:
        lea     MsgStart(pc),a0
        move.l  #MsgStartLen,d1
        bsr     PrintMsg

* --- I$Open (Update = Read+Write, damit SetStt ueberhaupt Sinn ergibt) -------
        lea     PathName(pc),a0
        moveq   #3,d0                   * Zugriffsmodus: Update (Read+Write)
        OS9     I_OPEN
        bcs     OpenErr
        lea     PathNum(pc),a3
        move.w  d0,(a3)
        lea     MsgOpenOk(pc),a0
        move.l  #MsgOpenOkLen,d1
        bsr     PrintMsg
        bra     DoSetStt

OpenErr:
        move.w  d1,d4
        lea     MsgOpenFail(pc),a0
        move.l  #MsgOpenFailLen,d1
        bsr     PrintMsg
        move.w  d4,d2
        bsr     PrintHexD2
        bra     Done

* --- I$SetStt(SS_Size) --------------------------------------------------------
DoSetStt:
        lea     PathNum(pc),a3
        move.w  (a3),d0
        moveq   #SS_Size,d1
        move.l  #NEW_SIZE,d2
        OS9     I_SETSTT
        bcs     SetSttErr
        lea     MsgSetSttOk(pc),a0
        move.l  #MsgSetSttOkLen,d1
        bsr     PrintMsg
        bra     DoClose

SetSttErr:
        move.w  d1,d4
        lea     MsgSetSttFail(pc),a0
        move.l  #MsgSetSttFailLen,d1
        bsr     PrintMsg
        move.w  d4,d2
        bsr     PrintHexD2
        bra     DoClose

* --- I$Close -------------------------------------------------------------------
DoClose:
        lea     PathNum(pc),a3
        move.w  (a3),d0
        OS9     I_CLOSE
        bcs     CloseErr
        lea     MsgCloseOk(pc),a0
        move.l  #MsgCloseOkLen,d1
        bsr     PrintMsg
        bra     Done

CloseErr:
        move.w  d1,d4
        lea     MsgCloseFail(pc),a0
        move.l  #MsgCloseFailLen,d1
        bsr     PrintMsg
        move.w  d4,d2
        bsr     PrintHexD2

Done:
        OS9     F$Exit

*───────────────────────────────────────────────────────────────────────────
PrintMsg:
        moveq   #STDOUT,d0
        OS9     I$WritLn
        rts

*───────────────────────────────────────────────────────────────────────────
PrintHexD2:
        lea     HexBuf(pc),a0
        move.b  #'$',(a0)+
        move.w  d2,d3
        moveq   #3,d1
HexLoop:
        move.w  d3,d0
        lsr.w   #8,d0
        lsr.w   #4,d0
        andi.w  #$0F,d0
        cmpi.b  #10,d0
        blt.s   HexDigit
        addi.b  #'A'-10,d0
        bra.s   HexStore
HexDigit:
        addi.b  #'0',d0
HexStore:
        move.b  d0,(a0)+
        lsl.w   #4,d3
        dbra    d1,HexLoop
        move.b  #$0D,(a0)+
        lea     HexBuf(pc),a0
        moveq   #6,d1
        bsr     PrintMsg
        rts

*───────────────────────────────────────────────────────────────────────────
MsgStart        dc.b    "=== dhfsetstt: I$Open/I$SetStt(SS_Size)/I$Close gegen /d0/hello.txt ===",$0D
MsgStartLen     equ     *-MsgStart

MsgOpenOk       dc.b    "OPEN: ok",$0D
MsgOpenOkLen    equ     *-MsgOpenOk

MsgOpenFail     dc.b    "OPEN: FEHLER, Code:",$0D
MsgOpenFailLen  equ     *-MsgOpenFail

MsgSetSttOk     dc.b    "SETSTT: ok",$0D
MsgSetSttOkLen  equ     *-MsgSetSttOk

MsgSetSttFail   dc.b    "SETSTT: FEHLER, Code:",$0D
MsgSetSttFailLen equ    *-MsgSetSttFail

MsgCloseOk      dc.b    "CLOSE: ok",$0D
MsgCloseOkLen   equ     *-MsgCloseOk

MsgCloseFail    dc.b    "CLOSE: FEHLER, Code:",$0D
MsgCloseFailLen equ     *-MsgCloseFail

PathName        dc.b    "/d0/hello.txt",0

        align   2
PathNum         ds.w    1
HexBuf          ds.b    8

        endsect
        end
