*═══════════════════════════════════════════════════════════════════════════
* File:   dhfrenfree_68k.a                                             Ver. 1.00
* Owner:  Claude
* Desc.:  Testprogramm fuer SS_Rename (I$SetStt) und SS_Free (I$GetStt).
*
* Edition History
*─────────┬──────┬────────────────────────────────────────────────────────┬──────
* Date    │ Ver. │ Description                                            │ By
*─────────┼──────┼────────────────────────────────────────────────────────┼──────
* 26-09-26│ 1.00 │ Erster Wurf                                            │ Cld
*═════════╧══════╧════════════════════════════════════════════════════════╧══════
        nam     dhfrfr
        ttl     Q9-DHF Testprogramm: SS_Rename/SS_Free

        use     q9defs.d

Edition         equ     1

I_OPEN          equ     $84
I_CLOSE         equ     $8f
I_GETSTT        equ     $8d
I_SETSTT        equ     $8e

SS_Rename       equ     $42
SS_Free         equ     $43

STDOUT          equ     1

        psect   dhfrfr,(Prgrm<<8)!Objct,0,Edition,1024,Start

Start:
        lea     MsgStart(pc),a0
        move.l  #MsgStartLen,d1
        bsr     PrintMsg

        lea     PathName(pc),a0
        moveq   #3,d0                    * Update (Read+Write)
        OS9     I_OPEN
        bcs     OpenErr
        lea     PathNum(pc),a3
        move.w  d0,(a3)
        lea     MsgOpenOk(pc),a0
        move.l  #MsgOpenOkLen,d1
        bsr     PrintMsg
        bra     TestFree

OpenErr:
        move.w  d1,d4
        lea     MsgOpenFail(pc),a0
        move.l  #MsgOpenFailLen,d1
        bsr     PrintMsg
        move.w  d4,d2
        bsr     PrintHexD2
        bra     Done

* --- SS_Free ---------------------------------------------------------------
TestFree:
        lea     PathNum(pc),a3
        move.w  (a3),d0
        moveq   #SS_Free,d1
        OS9     I_GETSTT
        bcs     FreeErr
        move.l  d0,d2                   * SICHERN vor dem naechsten PrintMsg-Aufruf --
                                         * PrintMsg selbst clobbert d0 (moveq #STDOUT,d0)!
        lea     MsgFreeOk(pc),a0
        move.l  #MsgFreeOkLen,d1
        bsr     PrintMsg
        bsr     PrintHexD2Long
        bra     TestRename
FreeErr:
        move.w  d1,d4
        lea     MsgFreeFail(pc),a0
        move.l  #MsgFreeFailLen,d1
        bsr     PrintMsg
        move.w  d4,d2
        bsr     PrintHexD2
        bra     TestRename

* --- SS_Rename ---------------------------------------------------------------
TestRename:
        lea     PathNum(pc),a3
        move.w  (a3),d0
        moveq   #SS_Rename,d1
        lea     NewName(pc),a0
        OS9     I_SETSTT
        bcs     RenameErr
        lea     MsgRenameOk(pc),a0
        move.l  #MsgRenameOkLen,d1
        bsr     PrintMsg
        bra     DoClose
RenameErr:
        move.w  d1,d4
        lea     MsgRenameFail(pc),a0
        move.l  #MsgRenameFailLen,d1
        bsr     PrintMsg
        move.w  d4,d2
        bsr     PrintHexD2
        bra     DoClose

DoClose:
        lea     PathNum(pc),a3
        move.w  (a3),d0
        OS9     I_CLOSE
        bcs     CloseErr
        lea     MsgCloseOk(pc),a0
        move.l  #MsgCloseOkLen,d1
        bsr     PrintMsg
        bra     Done
CloseErr:
        move.w  d1,d4
        lea     MsgCloseFail(pc),a0
        move.l  #MsgCloseFailLen,d1
        bsr     PrintMsg
        move.w  d4,d2
        bsr     PrintHexD2

Done:
        OS9     F$Exit

*───────────────────────────────────────────────────────────────────────────
PrintMsg:
        moveq   #STDOUT,d0
        OS9     I$WritLn
        rts

*───────────────────────────────────────────────────────────────────────────
PrintHexD2:
        lea     HexBuf(pc),a0
        move.b  #'$',(a0)+
        move.w  d2,d3
        moveq   #3,d1
HexLoop:
        move.w  d3,d0
        lsr.w   #8,d0
        lsr.w   #4,d0
        andi.w  #$0F,d0
        cmpi.b  #10,d0
        blt.s   HexDigit
        addi.b  #'A'-10,d0
        bra.s   HexStore
HexDigit:
        addi.b  #'0',d0
HexStore:
        move.b  d0,(a0)+
        lsl.w   #4,d3
        dbra    d1,HexLoop
        move.b  #$0D,(a0)+
        lea     HexBuf(pc),a0
        moveq   #6,d1
        bsr     PrintMsg
        rts

*───────────────────────────────────────────────────────────────────────────
PrintHexD2Long:
        lea     HexBuf(pc),a0
        move.b  #'$',(a0)+
        move.l  d2,d3
        moveq   #7,d1
HexLoopL:
        move.l  d3,d0
        lsr.l   #8,d0
        lsr.l   #8,d0
        lsr.l   #8,d0
        lsr.l   #4,d0
        andi.w  #$0F,d0
        cmpi.b  #10,d0
        blt.s   HexDigitL
        addi.b  #'A'-10,d0
        bra.s   HexStoreL
HexDigitL:
        addi.b  #'0',d0
HexStoreL:
        move.b  d0,(a0)+
        lsl.l   #4,d3
        dbra    d1,HexLoopL
        move.b  #$0D,(a0)+
        lea     HexBuf(pc),a0
        moveq   #10,d1
        bsr     PrintMsg
        rts

*───────────────────────────────────────────────────────────────────────────
MsgStart        dc.b    "=== dhfrenfree: SS_Free/SS_Rename gegen /d0/hello.txt ===",$0D
MsgStartLen     equ     *-MsgStart

MsgOpenOk       dc.b    "OPEN: ok",$0D
MsgOpenOkLen    equ     *-MsgOpenOk

MsgOpenFail     dc.b    "OPEN: FEHLER, Code:",$0D
MsgOpenFailLen  equ     *-MsgOpenFail

MsgFreeOk       dc.b    "SS_Free: ok, freier Speicher:",$0D
MsgFreeOkLen    equ     *-MsgFreeOk

MsgFreeFail     dc.b    "SS_Free: FEHLER, Code:",$0D
MsgFreeFailLen  equ     *-MsgFreeFail

MsgRenameOk     dc.b    "SS_Rename: ok (-> hello_renamed.txt)",$0D
MsgRenameOkLen  equ     *-MsgRenameOk

MsgRenameFail   dc.b    "SS_Rename: FEHLER, Code:",$0D
MsgRenameFailLen equ    *-MsgRenameFail

MsgCloseOk      dc.b    "CLOSE: ok",$0D
MsgCloseOkLen   equ     *-MsgCloseOk

MsgCloseFail    dc.b    "CLOSE: FEHLER, Code:",$0D
MsgCloseFailLen equ     *-MsgCloseFail

PathName        dc.b    "/d0/hello.txt",0
NewName         dc.b    "/d0/hello_renamed.txt",0

        align   2
PathNum         ds.w    1
HexBuf          ds.b    12

        endsect
        end
