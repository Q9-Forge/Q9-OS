*═══════════════════════════════════════════════════════════════════════════
* File:   dhfdrv_68k.a                                                Ver. 1.00
* Owner:  Claude
* Desc.:  Q9-DHF -- echtes OS-9-Treibermodul (68k), von Hand geschrieben (kein
*         QCC-DEFMODUL -- dessen DRIVER-Backend ist noch nicht fertig, s.
*         Q9-QCC/Q9-FRONTEND-C/q9-qcpp/docs/STATUS_DEFMODUL.md Phase 3/4).
*         Modulkopf + Einsprung-Sprungtabelle nach dem verifizierten Vorbild
*         eines echten Microware-Treibers (MWOS/OS9/SRC/IO/SCF/DRVR/
*         sc68681.a: Typ Q9Drivr, a1/a2/a4/a6-Konvention, Carry+d1-Fehler).
*
*         Der Treiber selbst tut so gut wie nichts (Andreas: "der Treiber
*         muss ja nicht viel machen, im Prinzip die Daten nur an die Hard-
*         wareschnittstelle weiter geben und wieder zurueck") -- er kopiert
*         eine vom Aufrufer im Gast-RAM bereitgestellte struct dhf_shared
*         (28 Byte, s. Q9-OS/Q9-DHFDRV-68k/include/dhf_shared.h) 1:1 in das
*         MMIO-Fenster des DHF-Emulator-Geraets (Q9-Flux-68k/src/devices/
*         dhf/q9_dhf.c, Basis konfigurierbar per Geraetedeskriptor M$Port,
*         s. Edition 1.10) und wieder zurueck. Das eigentliche
*         Verarbeiten (Host-Dateisystem-Zugriff) macht ausschliesslich das
*         Geraet, s. dessen eigenen Kopfkommentar.
*
*         Wie der Manager diesen Treiber erreicht, ist inzwischen geklaert und
*         real verifiziert (s. Q9-OS/Q9-DHF-68k/STATUS.md "Real driver-call
*         mechanism" + manager/dhfmgr_68k.a) -- ueber Devicetbl/mod_driver,
*         NICHT ueber das fruehere, fiktive "_os9_f_viread".
*
* Edition History
*─────────┬──────┬────────────────────────────────────────────────────────┬──────
* Date    │ Ver. │ Description                                            │ By
*─────────┼──────┼────────────────────────────────────────────────────────┼──────
* 26-09-25│ 1.00 │ Erster Wurf                                            │ Cld
* 26-09-27│ 1.10 │ MMIO-Basis jetzt aus M$Port/V_PORT (statischer Speicher,│ Cld
*         │      │ vom Kernel automatisch aus dem Deskriptor befuellt,    │
*         │      │ s. sc68681.a Init) statt fest einkompiliert. Init      │
*         │      │ liest den Basispfad-String aus M$DevCon des Deskriptors│
*         │      │ und loest damit DHF_CMD_INIT im Geraet aus.            │
*═════════╧══════╧════════════════════════════════════════════════════════╧══════
* 2026-09-27: interner Modulname MUSS <=6 Zeichen sein -- I$Attach kuerzt den aus M$PDev
* gelesenen Treibernamen intern auf 6 Zeichen, bevor es F$Load damit aufruft (gefunden per
* Q9_TRAP_TRACE_ALL-Instrumentierung im echten Emulator: F$Load bekam "dhfdrv" statt
* "dhfdrv_68k", darum E$MNF "Module Not Found" bei "iniz dhf0"). Der Dateiname bleibt
* bewusst "dhfdrv_68k.a" (Makefile/Tests/Doku verweisen bereits ueberall darauf) -- nur der
* interne Modulname (nam/psect) ist jetzt kurz.
        nam     dhfdrv
        ttl     Q9-DHF 68k-Treiber

        use     q9defs.d

Edition         equ     1

* Static-Storage-Groesse: MUSS mindestens sysioStatic sein (MWOS/OS9/SRC/DEFS/
* iodev.a: v_port(4)+v_lprc(2)+v_busy(2)+v_wake(2)+v_paths(4)+v_dumm1[8](32)
* = 46 Byte) -- "wird vom Kernel fuer ALLE Geraete verlangt" laut dortigem
* Kommentar. Bisher stand hier 0 (unbemerkt harmlos, solange (a2) nie gelesen
* wurde) -- jetzt braucht Read/Write/GetStat/SetStat/Init V_PORT daraus,
* 0 waere also ab jetzt ein echter Fehler gewesen.
STATIC_SIZE     equ     46

* MMIO-Basis des DHF-Emulator-Geraets kommt jetzt zur Laufzeit aus M$Port des
* Geraetedeskriptors -- der Kernel kopiert diesen Wert automatisch in Offset 0
* des Treiber-eigenen statischen Speichers (V_PORT, MWOS/OS9/SRC/DEFS/iodev.a),
* noch BEVOR Init aufgerufen wird (verifiziert an sc68681.a's echtem Init:
* "movea.l V_PORT(a2),a3"). Kein fest einkompilierter Wert mehr noetig.
V_PORT          equ     0

* Geraetedeskriptor-Feldoffset M$DevCon (module.a: "org M$IDSize" -- relativ zum
* GEMEINSAMEN 48-Byte-Modulkopf, NICHT zum psect-Beginn: Port(4)+Vector(1)+
* IRQLvl(1)+Prior(1)+Mode(1)+FMgr(2)+PDev(2) = 12 Byte davor, macht $30+12=$3C).
M$DevCon        equ     $3C             * Offset zur eigenen Options-Tabelle

* DHF-Kommandocode fuer Init (Q9-Flux-68k/src/devices/dhf/dhf_proto.h)
DHF_CMD_INIT    equ     18

* Byte-Offsets in struct dhf_shared (dhf_shared.h, #pragma pack(push,1)):
*   0 version(1) 1 command(1) 2 status(1) 3 flags(1) 4 seq(4)
*   8 a0(4) 12 a1(4) 16 d0(4) 20 d1(4) 24 d2(4)        = 28 Byte gesamt
SH_VERSION      equ     0
SH_COMMAND      equ     1
SH_STATUS       equ     2
SH_FLAGS        equ     3
SH_SEQ          equ     4
SH_A0           equ     8
SH_A1           equ     12
SH_D0           equ     16
SH_D1           equ     20
SH_D2           equ     24
SH_SIZE         equ     28

* Modulbeschreibung -----------------------------------------------------------

* Attribut/Revision: ReEnt+SupStat -- I/O-Systemmodule MUESSEN das System-State-Bit
* gesetzt haben (OS-9 v2.4 Technical I-O Manual, "File Managers": "They must have the
* system-state bit set in the attribute byte of the module header"), sonst schlaegt
* I$Attach fehl -- gefunden 2026-09-27 nach erfolglosem "iniz dhf0" im echten Emulator
* (die Sample-FileManager-Listing im selben Handbuch hatte es schon immer richtig:
* "Attr_Revs equ ((ReEnt+Supstat)<<8)+0", hier zunaechst uebersehen).
        psect   dhfdrv,(Q9Drivr<<8)!Q9Objct,((Q9ReEnt!Q9SupStat)<<8)!0,Edition,STATIC_SIZE,DhfEnt

* 2026-09-26: STATIC_SIZE als psect-Parameter 5 wird von qr68k/ql68k als "stksz"
* interpretiert (generische Stackgroesse), NICHT als Treiber-Statischspeicher --
* das ist ein eigenes ROF-Feld "statstorage", das nur ueber ein "ds" INNERHALB
* eines vsect-Blocks befuellt wird (s. q9-qr68k/README.md, ROF-Feldtabelle:
* "20 4 statstorage reservierte Daten (ds im vsect)"). Ohne diesen Block blieb
* der Modulkopf-Feld _mdata (mod_driver, Offset $38) auf 0, obwohl STATIC_SIZE=46
* im Quelltext stand -- der echte Kernel verlangt _mdata!=0 fuer JEDEN Treiber
* (gefunden per Disassemblierung des echten ioman-Moduls, Adresse $ece4-$edf8,
* nach "iniz dhf0" mit E$NORAM ($ed) statt Erfolg fehlschlug -- s. STATUS.md).
        vsect
        ds.b    STATIC_SIZE
        ends

********************
* Entry jump table (7 Worte, wie sc68681.a MpscEnt: Init/Read/Write/GetStat/
* SetStat/Term/Exception-Handler(0=keiner))
*
DhfEnt
        dc.w    Init
        dc.w    Read
        dc.w    Write
        dc.w    GetStat
        dc.w    SetStat
        dc.w    Term
        dc.w    0

        pag
***************
* Init -- liest den Basispfad-String aus der Options-Tabelle des Geraete-
*   deskriptors (M$DevCon) und loest damit DHF_CMD_INIT im Geraet aus (dessen
*   Handler ruft dhf_host_fs_init() mit diesem Pfad auf, s. dhf_emu_device.c).
*   Kein Basispfad konfiguriert (M$DevCon=0 oder Options-Tabelle liefert 0) ->
*   ueberspringen, das Geraet behaelt seinen bisherigen Basispfad.
*
*   Anders als Read/Write/GetStat/SetStat gibt es hier KEINEN vom Aufrufer
*   bereitgestellten Kommandoblock (a1 zeigt auf den Deskriptor, nicht auf
*   eine struct dhf_shared) -- die MMIO-Felder werden deshalb direkt
*   einzeln beschrieben statt ueber die Kopierschleife.
*
* Passed:  (a1) = Geraetedeskriptor
*          (a2) = Static-Storage-Adresse (V_PORT bereits vom Kernel befuellt)
*          (a4) = Prozessdeskriptor
*          (a6) = Systemglobal-Zeiger
* Returns: nichts
* Error:   (cc) = Carry gesetzt, d1.w = Fehlercode
* Destroys: d0-d1/a0/a3
*
Init:
        movem.l d0-d1/a0/a3,-(a7)
        move.w  M$DevCon(a1),d0
        beq.s   InitDone
        movea.l a1,a3
        adda.w  d0,a3                   Options-Tabelle des Deskriptors
        move.w  (a3),d0                 Offset des Basispfad-Strings darin
        beq.s   InitDone
        movea.l a1,a3
        adda.w  d0,a3                   a3 = Adresse des Basispfad-Strings

        movea.l (a2),a0                 a0 = konfigurierte MMIO-Basis (V_PORT)
        move.l  a3,SH_A0(a0)            Pfad-String-Zeiger direkt ins Register
* 2026-09-26: zweites DevCon-Wort = Laufwerks-Flags (Bit 0 = nur lesbar) -> d1
        move.w  M$DevCon(a1),d0
        moveq   #0,d1
        move.w  2(a1,d0.w),d1
        move.l  d1,SH_D1(a0)
        move.b  #DHF_CMD_INIT,SH_COMMAND(a0)  loest die Verarbeitung aus
InitDone:
        movem.l (a7)+,d0-d1/a0/a3
        andi    #$FE,ccr        Carry loeschen -- kein Fehler
        rts

        pag
***************
* Term -- kein eigener Zustand im Treiber (das Geraet haelt seinen Zustand
*   selbst, s. dhf_emu_device_t); noch kein DHF_CMD_TERM ausgeloest.
*
* Passed:  (a1) = Geraetedeskriptor
*          (a2) = Static-Storage-Adresse
*          (a4) = Prozessdeskriptor
*          (a6) = Systemglobal-Zeiger
* Returns: nichts
* Error:   (cc) = Carry gesetzt, d1.w = Fehlercode
* Destroys: nichts
*
Term:
        andi    #$FE,ccr        Carry loeschen -- kein Fehler
        rts

        pag
***************
* Read / Write / GetStat / SetStat
*   Gemeinsamer Kern: (a1) zeigt auf eine vom Aufrufer im Gast-RAM bereit-
*   gestellte struct dhf_shared mit schon gesetztem "command"-Feld. Wir
*   kopieren zuerst die Registerfelder (seq/a0/a1/d0/d1/d2, Offset 4..27),
*   dann als LETZTES das command-Byte (Offset 1) -- das Schreiben dieses
*   einen Bytes loest im Geraet die komplette Verarbeitung synchron aus
*   (dhf_emu_device_write8, s. dessen Kopfkommentar). Danach kopieren wir
*   status/a0/a1/d0/d1/d2 zurueck.
*
* Passed:  (a1) = Pfaddeskriptor-Adresse (zeigt auf struct dhf_shared)
*          (a2) = Static-Storage-Adresse (V_PORT bereits vom Kernel befuellt)
*          (a4) = Prozessdeskriptor
*          (a6) = Systemglobal-Zeiger
* Returns: (d0.l) = d1-Feld der struct dhf_shared nach Ausfuehrung
*                    (Bytezahl/neue Position, kommandoabhaengig)
* Error:   (cc) = Carry gesetzt wenn status<>0, d1.w = status
* Destroys: a0/a3, d0-d3
*
Read:
Write:
GetStat:
SetStat:
        movem.l d2-d3/a3,-(a7)         Arbeitsregister retten (a1/a2/a4/a6 laut Konvention unangetastet)

* Registerfelder kopieren (Offset SH_SEQ..SH_D2 einschliesslich, 24 Byte) --
* NOCH NICHT das command-Byte, das kommt zuletzt. a0 = konfigurierte MMIO-
* Basis (V_PORT, vom Kernel automatisch aus M$Port des Deskriptors befuellt).
        lea     SH_SEQ(a1),a3
        movea.l (a2),a0
        adda.w  #SH_SEQ,a0
        moveq   #24-1,d2
CopyIn: move.b  (a3)+,(a0)+
        dbra    d2,CopyIn

* command-Byte zuletzt schreiben -- loest die Verarbeitung aus. a0 zeigt nach
* der Kopierschleife auf MMIO-Basis+SH_SIZE, deshalb MMIO-Basis erneut laden.
        movea.l (a2),a0
        move.b  SH_COMMAND(a1),SH_COMMAND(a0)

* Ergebnis zurueckkopieren: status (1 Byte) und a0/a1/d0/d1/d2 (20 Byte). 2026-09-26: vorher nur
* d0/d1/d2 -- Open/Create liefern jetzt in a0/a1 die Pseudo-Sektornummern fuer pd_fd/pd_dfd
* (s. dhfmgr_68k.a MgrCommon); alle anderen Kommandos geben a0/a1 unveraendert zurueck.
        move.b  SH_STATUS(a0),SH_STATUS(a1)
        lea     SH_A0(a0),a0
        lea     SH_A0(a1),a3
        moveq   #20-1,d3
CopyOut: move.b (a0)+,(a3)+
        dbra    d3,CopyOut

* Rueckgabekonvention: d0.l = d1-Feld (Bytezahl/Position), Fehler ueber
* Carry+d1.w aus dem status-Byte (0 = OK).
        move.l  SH_D1(a1),d0
        moveq   #0,d1
        move.b  SH_STATUS(a1),d1
        beq.s   ReadOk
        movem.l (a7)+,d2-d3/a3
        ori     #1,ccr          Carry setzen -- Fehler, d1.w schon gesetzt
        rts
ReadOk:
        movem.l (a7)+,d2-d3/a3
        andi    #$FE,ccr        Carry loeschen -- kein Fehler
        rts

        endsect
        end
*───────────────────────────────────────────────────────────────────────────
* EOF dhfdrv_68k.a                                                    Ver. 1.00
*───────────────────────────────────────────────────────────────────────────
