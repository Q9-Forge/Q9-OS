*═════════════════════════════════════════════════════════════════════════════════════
* rbf_68k.a -- Random Block File Manager (RBF) for OS-9 / 68k
* Q9-OS Subsystem
*═════════════════════════════════════════════════════════════════════════════════════
        nam     rbf
        ttl     OS-9/68K Random Block File Manager

        use     q9defs.d
        use     rbf_defs.a

* Edition & Revision
Edition         equ     1
Revision        equ     0

*═════════════════════════════════════════════════════════════════════════════════════
* Modul-Header
* FlMgr, Objct, SupStat, ReEnt sind in q9defs.d definiert
*═════════════════════════════════════════════════════════════════════════════════════
        psect   rbf,(FlMgr<<8)|Objct,(SupStat+ReEnt<<8)|0,Edition,0,RbfEnt

*═════════════════════════════════════════════════════════════════════════════════════
* 13-Slot Sprungtabelle (M$Exec)
* WICHTIG: Relativ zu RbfEnt kodiert ("Label-RbfEnt"), da IOMan a0=M$Exec lädt
* und mit (a0,d0.w) relativ anspringt.
* Indizierung: (I$-Callcode - $83) * 2
*═════════════════════════════════════════════════════════════════════════════════════
RbfEnt:
        dc.w    Rbf_Create-RbfEnt       * Offset  0  I$Create  $83
        dc.w    Rbf_Open-RbfEnt         * Offset  2  I$Open    $84
        dc.w    Rbf_MakDir-RbfEnt       * Offset  4  I$MakDir  $85
        dc.w    Rbf_ChgDir-RbfEnt       * Offset  6  I$ChgDir  $86
        dc.w    Rbf_Delete-RbfEnt       * Offset  8  I$Delete  $87
        dc.w    Rbf_Seek-RbfEnt         * Offset 10  I$Seek    $88
        dc.w    Rbf_Read-RbfEnt         * Offset 12  I$Read    $89
        dc.w    Rbf_Write-RbfEnt        * Offset 14  I$Write   $8A
        dc.w    Rbf_ReadLn-RbfEnt       * Offset 16  I$ReadLn  $8B
        dc.w    Rbf_WritLn-RbfEnt       * Offset 18  I$WritLn  $8C
        dc.w    Rbf_GetStt-RbfEnt       * Offset 20  I$GetStt  $8D
        dc.w    Rbf_SetStt-RbfEnt       * Offset 22  I$SetStt  $8E
        dc.w    Rbf_Close-RbfEnt        * Offset 24  I$Close   $8F

*═════════════════════════════════════════════════════════════════════════════════════
* Untermodule einbinden
*═════════════════════════════════════════════════════════════════════════════════════
        use     rbf_drv.a
        use     rbf_fs.a
        use     rbf_ops.a
        use     rbf_write.a

*═════════════════════════════════════════════════════════════════════════════════════
* Modul-Abschluss & Close
*═════════════════════════════════════════════════════════════════════════════════════

Rbf_Close:
        * Puffer-Flush / Synchronisation
        bsr.w   Rbf_FlushCache
        * Bei non-zero PD_COUNT nichts tun (Dup-Pfade teilen Deskriptor)
        tst.w   PD_COUNT(a1)
        bne.s   Rbf_CloseDone
        * Ansonsten Erfolg zurückmelden
        andi    #$FE,ccr                * Carry löschen (Erfolg)
        rts

Rbf_CloseDone:
        andi    #$FE,ccr
        rts

Rbf_UnkSvc:
        move.w  #E_UNKSVC,d1
        ori     #$01,ccr                * Carry setzen (Fehler)
        rts

        ends
