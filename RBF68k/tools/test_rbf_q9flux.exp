#!/usr/bin/expect -f

set timeout 90
set send_slow {1 .005}
set prompt {[#$] ?$}

# Set working directory to Q9-Flux-68k
cd "/Volumes/SSD1TB/projects/Q9-Forge/Q9-SDK/SRC/SYSTEM/Q9-Flux/Q9-Flux-68k"

log_file -noappend "/Volumes/SSD1TB/projects/Q9-Forge/Q9-SDK/SRC/SYSTEM/Q9-OS/RBF68k/tools/rbf_boot_test.log"

spawn ./build/macos/q9.exe rbf68k-test.q9

set timeout 60
expect {
    "devices online" { send_user "\n\[OK\] Q9 Board booted and devices online!\n" }
    timeout { send_user "\n\[FAIL\] Timeout waiting for devices online!\n"; exit 1 }
}

set timeout 30
set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { sleep 1; send -s "mshell\r"; exp_continue }
        -re {Password[^\r\n]*:} { sleep 1; send -s "user\r"; exp_continue }
        -re $prompt { set logged_in 1 }
        timeout { send "\r" }
    }
}

if {!$logged_in} {
    send_user "\n\[FAIL\] Login failed!\n"
    exit 1
}

send_user "\n\[OK\] Logged in to OS-9 shell successfully!\n"

# 1. Modulidentifikation von rbf im Speicher
sleep 1
send -s "ident -m rbf\r"
expect -re $prompt

# 2. dir /dd
sleep 1
send -s "dir /dd\r"
expect -re $prompt

# 3. list /dd/startup
sleep 1
send -s "list /dd/startup\r"
expect -re $prompt

# 4. makdir /dd/TESTDIR
sleep 1
send -s "makdir /dd/TESTDIR\r"
expect -re $prompt

# 5. dir /dd (TESTDIR muss gelistet sein)
sleep 1
send -s "dir /dd\r"
expect -re $prompt

# 6. copy /dd/startup /dd/TESTDIR/TESTFILE
sleep 1
send -s "copy /dd/startup /dd/TESTDIR/TESTFILE\r"
expect -re $prompt

# 7. list /dd/TESTDIR/TESTFILE
sleep 1
send -s "list /dd/TESTDIR/TESTFILE\r"
expect -re $prompt

# 8. attr /dd/TESTDIR/TESTFILE e
sleep 1
send -s "attr /dd/TESTDIR/TESTFILE e\r"
expect -re $prompt

# 9. del /dd/TESTDIR/TESTFILE
sleep 1
send -s "del /dd/TESTDIR/TESTFILE\r"
expect -re $prompt

# 10. deldir /dd/TESTDIR
sleep 1
send -s "deldir /dd/TESTDIR\r"
expect {
    -re {Delete, List, or Quit[^\r\n]*\?} { send "d\r"; exp_continue }
    -re $prompt { }
}

# 11. dcheck /dd (Filesystem consistency)
sleep 1
send -s "dcheck /dd\r"
expect -re $prompt

# Logout
sleep 1
send -s "logout\r"
expect {
    -re {Logout after} { send_user "\n\[OK\] OS-9 Logout completed.\n" }
    timeout { send_user "\n\[WARN\] Logout timeout.\n" }
}

# Beende Emulator mit Ctrl-]
send "\x1d"
expect eof
send_user "\n\[SUCCESS\] ALL RBF68k INTEGRATION TESTS PASSED!\n"
